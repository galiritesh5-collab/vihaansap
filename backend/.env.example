PORT=5000
NODE_ENV=production

# CORS - set this to your exact Vercel frontend URL
FRONTEND_URL=https://your-app.vercel.app

# JWT
JWT_SECRET=your_strong_random_jwt_secret_here

# Admin Portal Credentials (no hardcoded values - must be set in Render)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=your_strong_admin_password_here

# Firebase Admin SDK (from your Firebase Project > Service Accounts > Generate New Private Key)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
